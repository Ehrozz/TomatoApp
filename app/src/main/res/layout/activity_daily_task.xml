<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_gray"
    tools:context=".DailyTask">

    <!-- Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/tomato_red"
        app:strokeWidth="1dp"
        app:strokeColor="#40FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle_white"
                android:padding="3dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/cultivarImageHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_logo"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.TomatoApp.Circle" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cultivarNameHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roma Tomato"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/dateHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: 2025-05-12"
                    android:textColor="#F0FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCard"
        android:layout_above="@id/bottom_navigation"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Task List Section -->
            <TextView
                android:id="@+id/taskSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Growth Plan"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/taskListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:paddingHorizontal="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Critical Actions"
                            android:textColor="@color/muted"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/taskCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/5 done"
                            android:textColor="@color/fresh_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/taskRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipTasks"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Skip"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#F5F5F5"
                    app:elevation="0dp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/muted" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComplete"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Finish"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:backgroundTint="@color/fresh_green"
                    app:cornerRadius="16dp"
                    app:elevation="4dp"
                    app:icon="@android:drawable/checkbox_on_background"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDailyExpenses"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="💰 Log Daily Expenses"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:backgroundTint="@color/orange" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonitorPlant"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="32dp"
                android:text="🔍 Monitor Plant Scan"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:backgroundTint="@color/sidebar_dark_green" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/nav_selected"
        app:itemTextColor="@color/nav_selected"
        app:labelVisibilityMode="labeled"
        app:elevation="16dp" />

</RelativeLayout>
