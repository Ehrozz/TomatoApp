<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top left category accent line -->
        <View
            android:id="@+id/categoryAccent"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_margin="16dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_pill_input"
            android:backgroundTint="@color/warm_orange" />

        <!-- Main row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Disease image thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/soft_cream"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/diseaseImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_logo"
                    android:scaleType="centerCrop"
                    android:contentDescription="Disease image" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Text content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Category type pill -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/categoryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/orange_light"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/categoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Fungal"
                        android:textColor="@color/warm_orange"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Disease name -->
                <TextView
                    android:id="@+id/diseaseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Early Blight"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Scientific / description snippet -->
                <TextView
                    android:id="@+id/diseaseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Causes dark lesions with yellow halos on leaves."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Arrow icon -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/muted"
                android:alpha="0.5"
                android:layout_marginStart="8dp"
                android:contentDescription="View details" />
        </LinearLayout>

        <!-- Bottom quick-info footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Symptom hint pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/green_light"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/symptomHint"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="👁 Leaf lesions"
                    android:textColor="@color/sidebar_dark_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Treatment hint pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/blue_light"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/treatmentHint"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="💊 Fungicide"
                    android:textColor="@color/blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Severity dot -->
            <TextView
                android:id="@+id/severityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Moderate"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
