<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".CameraInterface">

    <!-- Camera Preview (full-screen background) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        tools:background="@android:color/black" />

    <!-- Scan-area overlay guide (center reticle) -->
    <View
        android:id="@+id/focusIndicator"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:background="@drawable/focus_indicator"
        android:visibility="visible" />

    <!-- ===== TOP: Header Bar ===== -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        android:background="@drawable/header_gradient_overlay"
        android:fitsSystemWindows="true">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Plant Scan"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Online / Offline indicator pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectivityBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#CC2D7A3A"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <View
                    android:id="@+id/connectivityDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/circle_green"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/connectivityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== TASK CONTEXT PANEL (below header) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detectionContextPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerBar"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#E8FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#30FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN CONTEXT"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp" />

            <!-- Cultivar + Phase row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Cultivar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱  CULTIVAR"
                        android:textColor="@color/muted"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerCultivar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_spinner_minimal" />
                </LinearLayout>

                <!-- Vertical divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#20000000"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp" />

                <!-- Growth Phase -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿  GROWTH STAGE"
                        android:textColor="@color/muted"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerPhase"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_spinner_minimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Horizontal separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#18000000"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <!-- Daily Task context row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/orange_light"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="📋"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAILY TASK"
                        android:textColor="@color/muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/taskContextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitor Plant Scan"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Scan type chip -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scanTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/green_light"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/scanTypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Disease"
                        android:textColor="@color/sidebar_dark_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== BOTTOM CONTROLS ===== -->
    <RelativeLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bottom_nav_gradient">

        <!-- Gallery shortcut (left) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/openGalleryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Open Gallery"
            app:fabSize="mini"
            app:elevation="4dp"
            app:tint="@color/white"
            app:backgroundTint="#80FFFFFF" />

        <!-- Capture button (center, prominent) -->
        <LinearLayout
            android:id="@+id/scanButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Outer pulse ring -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal">

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#40E67E22"
                    android:layout_gravity="center" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/captureBtn"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/warm_orange"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <View
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/capture_button_inner" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TAP TO SCAN"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Menu button (right) -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- Hidden legacy view kept for compatibility -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/modelSelectorBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/warm_orange"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp" />
    </RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/nav_selected"
        app:itemTextColor="@color/nav_selected"
        app:labelVisibilityMode="labeled"
        app:elevation="16dp" />

</RelativeLayout>
