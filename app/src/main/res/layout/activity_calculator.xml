<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".Calculator">

    <!-- Main Content -->
    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- Summary Section (Premium Header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_green_gradient_rounded"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projected Net Income"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvNetIncomeCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textColor="@color/white"
                    android:fontFamily="serif"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/tvCultivarNameTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roma VF Tomato"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="#26FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvCompletionRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% Complete"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="#26FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>
                
                <View 
                    android:layout_width="match_parent" 
                    android:layout_height="0.5dp" 
                    android:background="#40FFFFFF" 
                    android:layout_marginTop="16dp" 
                    android:layout_marginBottom="12dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adjusted Net Income"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tvAdjustedNetIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Harvest Prediction Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Yield Prediction"
                                android:textColor="#2E7D32"
                                android:textSize="12sp" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/tvHarvestPredictionYieldPerHa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kg/ha"
                                android:textColor="#1B5E20"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Yield"
                                android:textColor="#2E7D32"
                                android:textSize="12sp" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/tvHarvestPredictionTotalYield"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kg"
                                android:textColor="#1B5E20"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Harvest Date"
                                android:textColor="#2E7D32"
                                android:textSize="12sp" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/tvHarvestPredictionDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="#1B5E20"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Farm Metrics Section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌾 Farm Metrics"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bottom_nav_gradient"
                            android:backgroundTint="@color/border">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Area / Hectare" android:textSize="12sp" android:textColor="@color/muted" />
                            <EditText android:id="@+id/etHectare" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/bg_pill_input" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textSize="13sp" android:textStyle="bold" android:gravity="end" android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Avg Weight / Fruit (g)" android:textSize="12sp" android:textColor="@color/muted" />
                            <EditText android:id="@+id/etAWF" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/bg_pill_input" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textSize="13sp" android:textStyle="bold" android:gravity="end" android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fruits per Plant" android:textSize="12sp" android:textColor="@color/muted" />
                            <EditText android:id="@+id/etAFP" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/bg_pill_input" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textSize="13sp" android:textStyle="bold" android:gravity="end" android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Market Value (₱/kg)" android:textSize="12sp" android:textColor="@color/muted" />
                            <EditText android:id="@+id/etMarketValue" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/bg_pill_input" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textSize="13sp" android:textStyle="bold" android:gravity="end" android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_pill_input">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sub-total Harvest" android:textSize="12sp" android:textColor="@color/muted" android:textStyle="bold" />
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView android:id="@+id/tvSubTotalHarvest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0.00" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/green" android:fontFamily="serif" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPENSES BREAKDOWN"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <!-- Labor Expense Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="👷"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="#E8F5E9"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Labor" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text" />
                            <TextView android:id="@+id/tvExpensesLaborTotal_Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logged entries" android:textSize="11sp" android:textColor="@color/muted" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvExpensesLaborTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/green" android:fontFamily="serif" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Material Expense Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="🧪"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="@color/blue_light"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Materials" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text" />
                            <TextView android:id="@+id/tvExpensesMaterialTotal_Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logged entries" android:textSize="11sp" android:textColor="@color/muted" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvExpensesMaterialTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/green" android:fontFamily="serif" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Equipment Expense Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="🔧"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="@color/orange_light"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Equipment" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text" />
                            <TextView android:id="@+id/tvExpensesEquipmentTotal_Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logged entries" android:textSize="11sp" android:textColor="@color/muted" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvExpensesEquipmentTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/green" android:fontFamily="serif" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Miscellaneous Expense Item -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="📝"
                            android:background="@drawable/bg_pill_input"
                            android:backgroundTint="#F5F5F5"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Miscellaneous" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text" />
                            <TextView android:id="@+id/tvExpensesMiscellaneousTotal_Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other expenses" android:textSize="11sp" android:textColor="@color/muted" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvExpensesMiscellaneousTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/green" android:fontFamily="serif" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveToAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save to Analytics"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/green_save"
                    app:cornerRadius="28dp" />

                <!-- Dummy/Hidden views for compatibility -->
                <TextView android:id="@+id/tvSummarySubtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvDateSaved" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvAdjustedSubtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvCompletionWarning" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvCultivarName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDailyExpensesHistory" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvNP" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <Spinner android:id="@+id/spinnerHarvestUnit" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/laborItemsContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvLaborTotalWorkers" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvLaborTotalCost" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/materialItemsContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvMaterialTotalCost" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/equipmentItemsContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvEquipmentTotalUsage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvEquipmentTotalCost" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/miscItemsContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvMiscellaneousTotalCost" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvTotalExpenses" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvAdjustedExpenses" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/nav_selected"
        app:itemTextColor="@color/nav_selected"
        app:labelVisibilityMode="labeled"
        app:elevation="16dp" />

</RelativeLayout>
