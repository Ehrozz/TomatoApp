<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Correct recorded milestones"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use this screen only to correct past dates. Future dates are not allowed." />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSeedsDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Seeds: not recorded" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSowingDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sowing: not recorded" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTransplantDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transplanting: not recorded" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop: not recorded" />
</LinearLayout>
