<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sidebar_dark_green"
    tools:context=".DiseaseView">

    <!-- ===== HEADER IMAGE ===== -->
    <FrameLayout
        android:id="@+id/headerImageContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/diseaseImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/disease_early_blight"
            android:scaleType="centerCrop"
            android:contentDescription="Disease illustration" />

        <!-- Bottom dark gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_gradient_dark" />

        <!-- "Tap to enlarge" hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to enlarge"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#80000000"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp" />
    </FrameLayout>

    <!-- ===== NAV BAR (overlaid on image top) ===== -->
    <LinearLayout
        android:id="@+id/disNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backButtonCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="#40FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_media_play"
                android:rotation="180"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:padding="8dp"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DISEASE INFO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginStart="14dp" />
    </LinearLayout>

    <!-- ===== SCROLLABLE CONTENT CARD (slides over image) ===== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_below="@id/headerImageContainer"
        android:layout_marginTop="-40dp"
        android:layout_above="@id/bottom_navigation">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="500dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="8dp"
            app:cardCornerRadius="28dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="48dp">

                <!-- ===== SEVERITY + NAME HEADER ===== -->
                <TextView
                    android:id="@+id/diseaseSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ Moderate Severity"
                    android:textColor="#B45309"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_pill_input"
                    android:backgroundTint="#FEF3E2"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/diseaseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Early Blight"
                    android:textColor="@color/text"
                    android:fontFamily="serif"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scientificName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alternaria solani"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginBottom="20dp" />

                <!-- ===== TAB ROW ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_pill_input"
                    android:backgroundTint="@color/soft_cream"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/tabSymptoms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="@color/green_light"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👁"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Symptoms"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/green"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabTreatment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_input"
                        android:layout_marginHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💊"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Treatment"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabPrevention"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_pill_input"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prevention"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== SYMPTOMS SECTION ===== -->
                <LinearLayout
                    android:id="@+id/sectionSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/green_light"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="👁"
                                android:textSize="15sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Symptoms"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diseaseDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dark brown to black lesions with concentric rings appear on older, lower leaves first. Lesions are surrounded by yellow halos."
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="20dp"
                        android:paddingStart="42dp" />

                    <!-- Cause sub-section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/orange_light"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🔬"
                                android:textSize="15sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cause"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diseaseCause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Caused by the fungus Alternaria solani. Spreads rapidly in warm, humid conditions between 24–29°C."
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="42dp" />
                </LinearLayout>

                <!-- ===== TREATMENT SECTION ===== -->
                <LinearLayout
                    android:id="@+id/sectionTreatment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F4FF"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="💊"
                                android:textSize="15sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recommended Treatment"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diseaseCure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Apply copper-based or chlorothalonil fungicides at first sign. Remove infected leaves promptly. Repeat every 7–10 days."
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="42dp" />
                </LinearLayout>

                <!-- ===== PREVENTION SECTION ===== -->
                <LinearLayout
                    android:id="@+id/sectionPrevention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F0E8FF"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🛡"
                                android:textSize="15sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prevention Measures"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diseasePrevention"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ensure crop rotation, proper spacing for air circulation, and use disease-free seeds. Avoid overhead irrigation."
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="42dp" />
                </LinearLayout>

                <!-- ===== HIDDEN LEGACY COMPATIBILITY VIEWS ===== -->
                <LinearLayout android:id="@+id/symptomsButton"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/treatmentButton"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/preventionButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/pestCommonName"       android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/pestScientificName"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/pestDescription"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/diseaseSymptoms"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/pestImageCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                    <ImageView android:id="@+id/pestImage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/nav_selected"
        app:itemTextColor="@color/nav_selected"
        app:labelVisibilityMode="labeled"
        app:elevation="16dp" />

</RelativeLayout>
