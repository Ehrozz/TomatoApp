<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:background="@color/cream">

    <LinearLayout 
        android:id="@+id/main" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:orientation="vertical">
        
        <ScrollView 
            android:layout_width="match_parent" 
            android:layout_height="0dp" 
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">
            
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="vertical" 
                android:padding="20dp">
                
                <!-- New Branded Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/headerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/fresh_green"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_circle_white"
                            android:padding="4dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/cultivarImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/tomato_placeholder"
                                android:scaleType="centerInside"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.TomatoApp.Circle" />
                            
                            <TextView
                                android:id="@+id/cultivarEmoji"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🍅"
                                android:gravity="center"
                                android:textSize="40sp"
                                android:visibility="visible"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cultivarNameText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Roma VF Tomato"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />

                            <TextView
                                android:id="@+id/startDateText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Started: March 1, 2025"
                                android:textColor="#E0FFFFFF"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#40FFFFFF">
                                
                                <TextView
                                    android:id="@+id/seasonTagText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:text="Season 2025"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Program Progress Card (collapsible)                 -->
                <!-- ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/progressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- ── Always-visible summary row ── -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Program Progress"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/progressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/fresh_green"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp" />

                            <!-- Collapse toggle chevron -->
                            <ImageView
                                android:id="@+id/progressToggleBtn"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@android:drawable/arrow_down_float"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/muted" />
                        </LinearLayout>

                        <!-- Overall progress bar -->
                        <ProgressBar
                            android:id="@+id/progressBarOverall"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_green"
                            android:layout_marginBottom="6dp" />

                        <!-- "Day X of Y" label -->
                        <TextView
                            android:id="@+id/progressDayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Day 0 of 105"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <!-- ═══════════════════════════════════════════════ -->
                        <!-- Collapsible section (GONE by default)           -->
                        <!-- ═══════════════════════════════════════════════ -->
                        <LinearLayout
                            android:id="@+id/progressDetailsSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="14dp" />

                            <!-- Phase breakdown label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phase Breakdown"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp" />

                            <!-- Phase 1 — Land Prep -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.2"
                                    android:text="🌱 Land Prep"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                                <ProgressBar
                                    android:id="@+id/progressPhase1"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_weight="4"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_bar_green" />
                                <TextView
                                    android:id="@+id/progressPhase1Pct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0%"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp"
                                    android:gravity="end" />
                            </LinearLayout>

                            <!-- Phase 2 — Vegetative -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.2"
                                    android:text="🌿 Vegetative"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                                <ProgressBar
                                    android:id="@+id/progressPhase2"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_weight="4"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_bar_green" />
                                <TextView
                                    android:id="@+id/progressPhase2Pct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0%"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp"
                                    android:gravity="end" />
                            </LinearLayout>

                            <!-- Phase 3 — Flowering -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.2"
                                    android:text="🌸 Flowering"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                                <ProgressBar
                                    android:id="@+id/progressPhase3"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_weight="4"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_bar_orange" />
                                <TextView
                                    android:id="@+id/progressPhase3Pct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0%"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp"
                                    android:gravity="end" />
                            </LinearLayout>

                            <!-- Phase 4 — Maturity -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.2"
                                    android:text="🍅 Maturity"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                                <ProgressBar
                                    android:id="@+id/progressPhase4"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_weight="4"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_bar_orange" />
                                <TextView
                                    android:id="@+id/progressPhase4Pct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0%"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp"
                                    android:gravity="end" />
                            </LinearLayout>

                            <!-- Phase 5 — Harvest -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.2"
                                    android:text="🌾 Harvest"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                                <ProgressBar
                                    android:id="@+id/progressPhase5"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_weight="4"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_bar_red" />
                                <TextView
                                    android:id="@+id/progressPhase5Pct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0%"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp"
                                    android:gravity="end" />
                            </LinearLayout>

                            <!-- Divider before stats -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"
                                android:layout_marginBottom="14dp" />

                            <!-- Stats row: Done / Missed / Skipped -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="3">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_stat_chip_green"
                                    android:layout_marginEnd="6dp"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/progressStatCompleted"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/sidebar_dark_green"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="✅ Done"
                                        android:textColor="@color/sidebar_dark_green"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_stat_chip_red"
                                    android:layout_marginEnd="6dp"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/progressStatMissed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/red_dark"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⚠️ Missed"
                                        android:textColor="@color/red_dark"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_stat_chip_orange"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/progressStatSkipped"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/orange"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⏭️ Skipped"
                                        android:textColor="@color/orange"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                        <!-- End collapsible section -->

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Calendar Card -->
                <com.google.android.material.card.MaterialCardView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:layout_marginBottom="20dp" 
                    app:cardBackgroundColor="@color/white" 
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                    
                    <LinearLayout 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crop Schedule Calendar"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />
                        
                        <com.prolificinteractive.materialcalendarview.MaterialCalendarView 
                            android:id="@+id/CalendarView" 
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content"
                            app:mcv_selectionColor="@color/fresh_green_light"
                            app:mcv_showOtherDates="all"
                            app:mcv_calendarMode="month"
                            app:mcv_headerTextAppearance="@style/CalendarHeaderStyle"
                            app:mcv_dateTextAppearance="@style/CalendarDateStyle"
                            app:mcv_weekDayTextAppearance="@style/CalendarWeekDayStyle" />

                        <!-- Calendar Legend -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="16dp">

                            <!-- Row 1 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginBottom="8dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="16dp">
                                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_calendar_day_landprep" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Land Prep" android:textSize="11sp" android:textColor="@color/muted" android:textStyle="bold"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="16dp">
                                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_calendar_day_vegetative" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vegetative" android:textSize="11sp" android:textColor="@color/muted" android:textStyle="bold"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_calendar_day_flowering" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flowering" android:textSize="11sp" android:textColor="@color/muted" android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 2 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="16dp">
                                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_calendar_day_maturity" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maturity" android:textSize="11sp" android:textColor="@color/muted" android:textStyle="bold"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_calendar_day_harvest" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Post-Harvest" android:textSize="11sp" android:textColor="@color/muted" android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Season Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Season Summary"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="20dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <!-- Days Active -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/summaryDaysActive"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="54"
                                    android:textColor="@color/sidebar_dark_green"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Days Active"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Expenses -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/summaryExpenses"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₱12.4k"
                                    android:textColor="@color/chart_orange"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:fontFamily="serif" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Expenses"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Tasks Due -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/summaryTasksDue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3"
                                    android:textColor="#3498DB"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tasks Due"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMilestones"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Correct recorded milestones"
                    android:layout_marginBottom="12dp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton 
                    android:id="@+id/btnCurrentExpenses" 
                    android:layout_width="match_parent" 
                    android:layout_height="60dp" 
                    android:text="💰 View Daily Expenses Overview" 
                    app:cornerRadius="16dp" 
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/orange"
                    android:layout_marginBottom="40dp"
                    app:elevation="4dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    
    <!-- Dummy components for backward compatibility to prevent crashes -->
    <View android:id="@+id/floatingFormCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Spinner android:id="@+id/cultivarSpinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <EditText android:id="@+id/landAreaInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <DatePicker android:id="@+id/startDatePicker" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/btnSubmitForm" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/calendarHeader" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <ImageView android:id="@+id/headerCultivarImage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/headerCultivarName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/headerStartDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/taskWarningBanner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</RelativeLayout>
