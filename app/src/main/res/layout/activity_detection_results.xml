<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetectionResults">

    <!-- Main scrollable content -->
    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:layout_marginTop="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Detection Title -->
            <TextView
                android:id="@+id/detectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detection Result"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <!-- Detected Image -->
            <ImageView
                android:id="@+id/detectionImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Detected image"
                android:layout_marginBottom="8dp" />

            <!-- Detected Description -->
            <TextView
                android:id="@+id/detectionDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details about the detected result."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Symptoms Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symptoms"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/detectionSymptoms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symptoms go here."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Cause Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cause"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/detectionCause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cause goes here."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Cure Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cure"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/detectionCure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cure goes here."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Prevention Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prevention"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/detectionPrevention"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prevention measures go here."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Pest Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pest Information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/pestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pest Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingBottom="8dp" />

            <ImageView
                android:id="@+id/pestImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Pest image"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/pestDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brief description about the pest."
                android:textSize="16sp"
                android:paddingBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <!-- Detection Accuracy -->
            <TextView
                android:id="@+id/detectionAccuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detection Accuracy: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:paddingTop="12dp"
                android:paddingBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
